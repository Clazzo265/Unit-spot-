rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Core primitive helpers
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedAccount() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function groupExists(groupId) {
      return exists(/databases/$(database)/documents/groups/$(groupId));
    }

    function groupDoc(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)).data;
    }

    function memberDocExists(groupId, uid) {
      return exists(/databases/$(database)/documents/groups/$(groupId)/members/$(uid));
    }

    function memberDoc(groupId, uid) {
      return get(/databases/$(database)/documents/groups/$(groupId)/members/$(uid)).data;
    }

    // Strict active group membership check (revoked/suspended/removed members lose access immediately)
    function isActiveGroupMember(groupId) {
      return isSignedIn() && groupExists(groupId) && (
        groupDoc(groupId).adminId == request.auth.uid ||
        ('treasurerId' in groupDoc(groupId) && groupDoc(groupId).treasurerId == request.auth.uid) ||
        (
          ('memberUids' in groupDoc(groupId) && request.auth.uid in groupDoc(groupId).memberUids) &&
          (!memberDocExists(groupId, request.auth.uid) || memberDoc(groupId, request.auth.uid).status == 'active')
        ) ||
        (
          memberDocExists(groupId, request.auth.uid) &&
          memberDoc(groupId, request.auth.uid).status == 'active'
        )
      );
    }

    // Primary group owner / admin only
    function isGroupAdmin(groupId) {
      return isVerifiedAccount() &&
             groupExists(groupId) &&
             groupDoc(groupId).adminId == request.auth.uid;
    }

    // Group administrator or active treasurer
    function isGroupManager(groupId) {
      return isVerifiedAccount() && groupExists(groupId) && (
        groupDoc(groupId).adminId == request.auth.uid ||
        ('treasurerId' in groupDoc(groupId) && groupDoc(groupId).treasurerId == request.auth.uid) ||
        (
          memberDocExists(groupId, request.auth.uid) &&
          memberDoc(groupId, request.auth.uid).roleInGroup in ['admin', 'treasurer'] &&
          memberDoc(groupId, request.auth.uid).status == 'active'
        )
      );
    }

    function isValidGroupCategory(cat) {
      return cat in [
        'house', 'hostel', 'family', 'friends', 'savings_group',
        'church', 'business', 'club', 'community', 'project',
        'workplace', 'event', 'other'
      ];
    }

    function isValidExpenseCategory(cat) {
      return cat in [
        'electricity', 'water', 'rent', 'internet', 'security',
        'waste', 'groceries', 'maintenance', 'utilities', 'savings',
        'welfare', 'school', 'project', 'event', 'transport',
        'emergency', 'dues', 'other'
      ];
    }

    // Strict schema validators aligned with firebase-blueprint.json & TypeScript interfaces
    function isValidUser(data) {
      return data.keys().hasAll(['id', 'name', 'email', 'role', 'createdAt']) &&
             data.keys().hasOnly([
               'id', 'name', 'email', 'phone', 'role', 'roomNumber',
               'avatarUrl', 'preferredLanguage', 'createdAt'
             ]) &&
             isValidId(data.id) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 120 &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 30)) &&
             (!('roomNumber' in data) || (data.roomNumber is string && data.roomNumber.size() <= 50)) &&
             (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 500)) &&
             data.role in ['group_admin', 'treasurer', 'member', 'super_admin'] &&
             (!('preferredLanguage' in data) || data.preferredLanguage in ['en', 'ny']) &&
             data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() <= 64;
    }

    function isValidGroup(data) {
      return data.keys().hasAll(['id', 'name', 'category', 'adminId', 'defaultCurrency', 'joinCode', 'createdAt']) &&
             data.keys().hasOnly([
               'id', 'name', 'description', 'category', 'adminId', 'treasurerId',
               'memberUids', 'defaultCurrency', 'paymentRules', 'joinCode', 'joinPolicy',
               'inviteRevoked', 'inviteExpiresAt', 'inviteExpiresAtMs', 'status',
               'archivedAt', 'archivedBy', 'archiveReason', 'createdAt', 'updatedAt', 'memberCount'
             ]) &&
             isValidId(data.id) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
             (!('description' in data) || (data.description is string && data.description.size() <= 500)) &&
             isValidGroupCategory(data.category) &&
             isValidId(data.adminId) &&
             (!('treasurerId' in data) || isValidId(data.treasurerId)) &&
             data.defaultCurrency is string && data.defaultCurrency.size() > 0 && data.defaultCurrency.size() <= 10 &&
             (!('paymentRules' in data) || (data.paymentRules is string && data.paymentRules.size() <= 1000)) &&
             data.joinCode is string && data.joinCode.size() > 0 && data.joinCode.size() <= 50 &&
             (!('joinPolicy' in data) || data.joinPolicy in ['code_auto', 'admin_approval']) &&
             (!('inviteRevoked' in data) || data.inviteRevoked is bool) &&
             (!('inviteExpiresAt' in data) || (data.inviteExpiresAt is string && data.inviteExpiresAt.size() <= 64)) &&
             (!('inviteExpiresAtMs' in data) || data.inviteExpiresAtMs is number) &&
             (!('memberUids' in data) || (data.memberUids is list && data.memberUids.size() <= 200)) &&
             (!('memberCount' in data) || (data.memberCount is number && data.memberCount >= 0 && data.memberCount <= 500)) &&
             (!('status' in data) || data.status in ['active', 'archived']) &&
             data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() <= 64;
    }

    function isValidGroupInvite(data) {
      return data.keys().hasAll(['inviteCode', 'groupId', 'groupName', 'category', 'joinPolicy', 'revoked', 'adminId', 'createdAt']) &&
             data.keys().hasOnly([
               'inviteCode', 'groupId', 'groupName', 'category', 'joinPolicy',
               'revoked', 'adminId', 'expiresAt', 'expiresAtMs', 'createdAt', 'updatedAt'
             ]) &&
             isValidId(data.inviteCode) &&
             isValidId(data.groupId) &&
             data.groupName is string && data.groupName.size() > 0 && data.groupName.size() <= 120 &&
             isValidGroupCategory(data.category) &&
             data.joinPolicy in ['code_auto', 'admin_approval'] &&
             data.revoked is bool &&
             isValidId(data.adminId) &&
             (!('expiresAt' in data) || (data.expiresAt is string && data.expiresAt.size() <= 64)) &&
             (!('expiresAtMs' in data) || data.expiresAtMs is number) &&
             data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() <= 64;
    }

    function isValidJoinRequest(data) {
      return data.keys().hasAll(['id', 'groupId', 'userId', 'name', 'email', 'inviteCode', 'status', 'createdAt']) &&
             data.keys().hasOnly([
               'id', 'groupId', 'userId', 'name', 'email', 'phone',
               'inviteCode', 'status', 'createdAt', 'reviewedAt', 'reviewedBy'
             ]) &&
             isValidId(data.id) &&
             isValidId(data.groupId) &&
             isValidId(data.userId) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
             data.email is string && data.email.size() <= 120 &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 30)) &&
             data.inviteCode is string && data.inviteCode.size() > 0 && data.inviteCode.size() <= 50 &&
             data.status in ['pending', 'approved', 'rejected'] &&
             data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() <= 64;
    }

    function isValidGroupMember(data) {
      return data.keys().hasAll(['id', 'groupId', 'userId', 'name', 'email', 'roleInGroup', 'joinedAt', 'status']) &&
             data.keys().hasOnly([
               'id', 'userId', 'linkedUserId', 'joinedViaInvite', 'inviteCodeUsed', 'groupId',
               'name', 'email', 'phone', 'memberRefId', 'roleInGroup', 'stoveType',
               'stoveTypeReviewRequired', 'stoveTypeUpdatedAt', 'stoveTypeUpdatedBy',
               'stoveTypeChangeReason', 'membershipDate', 'joinedAt', 'status',
               'departedAt', 'departureReason', 'roomNumber', 'notes',
               'removedAt', 'removalReason', 'suspendedAt', 'suspensionReason',
               'createdAt', 'updatedAt'
             ]) &&
             isValidId(data.id) &&
             isValidId(data.groupId) &&
             isValidId(data.userId) &&
             (!('linkedUserId' in data) || isValidId(data.linkedUserId)) &&
             (!('inviteCodeUsed' in data) || (data.inviteCodeUsed is string && data.inviteCodeUsed.size() <= 50)) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
             data.email is string && data.email.size() <= 120 &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 30)) &&
             (!('roomNumber' in data) || (data.roomNumber is string && data.roomNumber.size() <= 50)) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 500)) &&
             data.roleInGroup in ['admin', 'treasurer', 'member'] &&
             data.status in ['active', 'suspended', 'removed', 'departed'] &&
             (!('stoveType' in data) || data.stoveType == null || data.stoveType in ['electric', 'non_electric']) &&
             data.joinedAt is string && data.joinedAt.size() > 0 && data.joinedAt.size() <= 64;
    }

    function isValidContribution(data) {
      return data.keys().hasAll(['id', 'groupId', 'title', 'category', 'totalTargetAmount', 'deadline', 'status', 'createdAt']) &&
             data.keys().hasOnly([
               'id', 'groupId', 'title', 'category', 'customCategoryLabel', 'allocationMode',
               'month', 'year', 'totalTargetAmount', 'deadline', 'hasNoDeadline', 'description',
               'responsiblePersonId', 'supportingDocumentUrl', 'supportingDocumentName',
               'supportingDocumentType', 'supportingDocumentSize', 'supportingStoragePath',
               'status', 'rateConfigVersion', 'createdAt'
             ]) &&
             isValidId(data.id) &&
             isValidId(data.groupId) &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 120 &&
             isValidExpenseCategory(data.category) &&
             (!('customCategoryLabel' in data) || (data.customCategoryLabel is string && data.customCategoryLabel.size() <= 80)) &&
             (!('allocationMode' in data) || data.allocationMode in ['stove_rate', 'percentage', 'custom', 'equal']) &&
             data.totalTargetAmount is number && data.totalTargetAmount >= 0 &&
             (!('hasNoDeadline' in data) || data.hasNoDeadline is bool) &&
             (!('description' in data) || (data.description is string && data.description.size() <= 500)) &&
             (!('responsiblePersonId' in data) || isValidId(data.responsiblePersonId)) &&
             (!('supportingDocumentUrl' in data) || (data.supportingDocumentUrl is string && data.supportingDocumentUrl.size() <= 2000)) &&
             (!('supportingDocumentName' in data) || (data.supportingDocumentName is string && data.supportingDocumentName.size() <= 180)) &&
             (!('supportingDocumentType' in data) || (data.supportingDocumentType is string && data.supportingDocumentType.size() <= 100)) &&
             (!('supportingDocumentSize' in data) || (data.supportingDocumentSize is number && data.supportingDocumentSize >= 0)) &&
             (!('supportingStoragePath' in data) || (data.supportingStoragePath is string && data.supportingStoragePath.size() <= 400)) &&
             data.status in ['active', 'closed'] &&
             data.deadline is string && data.deadline.size() <= 64 &&
             data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() <= 64;
    }

    function isValidAssignment(data) {
      return data.keys().hasAll(['id', 'contributionId', 'groupId', 'memberId', 'assignedAmount', 'assignedDate', 'deadline', 'status']) &&
             data.keys().hasOnly([
               'id', 'contributionId', 'groupId', 'memberId', 'memberUid', 'assignedAmount',
               'allocationPercentage', 'applicableRate', 'stoveTypeAtAssignment', 'rateConfigVersion',
               'assignedDate', 'deadline', 'notes', 'status'
             ]) &&
             isValidId(data.id) &&
             isValidId(data.contributionId) &&
             isValidId(data.groupId) &&
             isValidId(data.memberId) &&
             (!('memberUid' in data) || isValidId(data.memberUid)) &&
             data.assignedAmount is number && data.assignedAmount > 0 &&
             (!('allocationPercentage' in data) || (data.allocationPercentage is number && data.allocationPercentage >= 0 && data.allocationPercentage <= 100)) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 300)) &&
             data.status in ['unpaid', 'partially_paid', 'submitted', 'pending_verification', 'verified', 'rejected', 'disputed', 'reversed', 'overdue', 'fully_settled'] &&
             (!('stoveTypeAtAssignment' in data) || data.stoveTypeAtAssignment == null || data.stoveTypeAtAssignment in ['electric', 'non_electric']);
    }

    function isValidPayment(data) {
      return data.keys().hasAll(['id', 'assignmentId', 'groupId', 'memberId', 'amountReceived', 'paymentDate', 'paymentMethod', 'transactionReference', 'collectorId', 'verificationStatus', 'createdAt']) &&
             data.keys().hasOnly([
               'id', 'assignmentId', 'contributionId', 'groupId', 'memberId', 'memberUid',
               'amountReceived', 'paymentDate', 'paymentMethod', 'transactionReference',
               'idempotencyKey', 'collectorId', 'submittedByMemberId', 'verificationStatus',
               'rejectionReason', 'verifiedAt', 'verifiedBy', 'reversedAt', 'reversedBy',
               'reversalReason', 'reversedByPaymentId', 'disputedAt', 'disputedBy',
               'disputeReason', 'receiptEvidenceUrl', 'receiptImageUrl', 'receiptStoragePath',
               'receiptFileName', 'receiptFileType', 'receiptFileSize',
               'receiptNote', 'createdAt'
             ]) &&
             isValidId(data.id) &&
             isValidId(data.assignmentId) &&
             isValidId(data.groupId) &&
             isValidId(data.memberId) &&
             (!('memberUid' in data) || isValidId(data.memberUid)) &&
             isValidId(data.collectorId) &&
             data.amountReceived is number && data.amountReceived > 0 &&
             data.paymentMethod in ['airtel_money', 'tnm_mpamba', 'bank_transfer', 'cash', 'other'] &&
             data.transactionReference is string && data.transactionReference.size() <= 100 &&
             (!('receiptNote' in data) || (data.receiptNote is string && data.receiptNote.size() <= 500)) &&
             (!('receiptStoragePath' in data) || (data.receiptStoragePath is string && data.receiptStoragePath.size() <= 400)) &&
             (!('receiptFileName' in data) || (data.receiptFileName is string && data.receiptFileName.size() <= 180)) &&
             (!('receiptFileType' in data) || (data.receiptFileType is string && data.receiptFileType.size() <= 100)) &&
             (!('receiptFileSize' in data) || (data.receiptFileSize is number && data.receiptFileSize >= 0)) &&
             (!('receiptImageUrl' in data) || (data.receiptImageUrl is string && data.receiptImageUrl.size() <= 800000)) &&
             (!('receiptEvidenceUrl' in data) || (data.receiptEvidenceUrl is string && data.receiptEvidenceUrl.size() <= 800000)) &&
             data.verificationStatus in ['submitted', 'pending_verification', 'verified', 'rejected', 'disputed', 'reversed'] &&
             data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() <= 64;
    }

    function isValidCommitment(data) {
      return data.keys().hasAll(['id', 'assignmentId', 'memberId', 'groupId', 'originalOutstandingAmount', 'currentOutstandingAmount', 'commitmentDate', 'promisedDate', 'collectorId', 'status']) &&
             data.keys().hasOnly([
               'id', 'assignmentId', 'memberId', 'memberUid', 'groupId', 'contributionId',
               'originalOutstandingAmount', 'currentOutstandingAmount', 'amountAlreadyReceived',
               'commitmentDate', 'promisedDate', 'durationDays', 'collectorId', 'notes',
               'status', 'memberConfirmed', 'extensionCount', 'completedAt'
             ]) &&
             isValidId(data.id) &&
             isValidId(data.assignmentId) &&
             isValidId(data.memberId) &&
             (!('memberUid' in data) || isValidId(data.memberUid)) &&
             isValidId(data.groupId) &&
             isValidId(data.collectorId) &&
             data.originalOutstandingAmount is number && data.originalOutstandingAmount >= 0 &&
             data.currentOutstandingAmount is number && data.currentOutstandingAmount >= 0 &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 500)) &&
             data.status in ['active', 'due_soon', 'due_today', 'completed', 'overdue', 'extension_requested', 'revised'];
    }

    function isValidCommitmentEvent(data) {
      return data.keys().hasAll(['id', 'commitmentId', 'date', 'eventType', 'notes', 'recordedBy']) &&
             data.keys().hasOnly([
               'id', 'commitmentId', 'groupId', 'memberUid', 'date', 'eventType',
               'notes', 'recordedBy', 'newPromisedDate', 'amountPaid'
             ]) &&
             isValidId(data.id) &&
             isValidId(data.commitmentId) &&
             (!('groupId' in data) || isValidId(data.groupId)) &&
             (!('memberUid' in data) || isValidId(data.memberUid)) &&
             isValidId(data.recordedBy) &&
             data.eventType in ['created', 'reminder_sent', 'extension_requested', 'extension_approved', 'extension_declined', 'extension_granted', 'partial_payment', 'completed', 'broken', 'revised'] &&
             data.notes is string && data.notes.size() > 0 && data.notes.size() <= 500 &&
             data.date is string && data.date.size() <= 64;
    }

    function isValidExpense(data) {
      return data.keys().hasAll(['id', 'groupId', 'name', 'category', 'amount', 'date', 'responsiblePersonId', 'status', 'createdAt']) &&
             data.keys().hasOnly([
               'id', 'groupId', 'name', 'category', 'customCategoryLabel', 'amount', 'date',
               'description', 'responsiblePersonId', 'receiptNumber', 'receiptEvidenceUrl',
               'receiptImageUrl', 'receiptStoragePath', 'receiptFileName', 'receiptFileType',
               'receiptFileSize', 'paymentReference', 'status', 'approvedBy', 'approvedAt', 'createdAt'
             ]) &&
             isValidId(data.id) &&
             isValidId(data.groupId) &&
             isValidId(data.responsiblePersonId) &&
             data.amount is number && data.amount > 0 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
             (!('customCategoryLabel' in data) || (data.customCategoryLabel is string && data.customCategoryLabel.size() <= 80)) &&
             (!('description' in data) || (data.description is string && data.description.size() <= 500)) &&
             (!('receiptFileName' in data) || (data.receiptFileName is string && data.receiptFileName.size() <= 180)) &&
             (!('receiptFileType' in data) || (data.receiptFileType is string && data.receiptFileType.size() <= 100)) &&
             (!('receiptFileSize' in data) || (data.receiptFileSize is number && data.receiptFileSize >= 0)) &&
             isValidExpenseCategory(data.category) &&
             data.status in ['approved', 'pending_approval', 'rejected'] &&
             data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() <= 64;
    }

    function isValidDispute(data) {
      return data.keys().hasAll(['id', 'groupId', 'memberId', 'title', 'description', 'status', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly([
               'id', 'groupId', 'assignmentId', 'relatedAssignmentId', 'paymentId',
               'memberId', 'memberUid', 'title', 'description', 'expectedAmount',
               'paidAmountClaimed', 'claimedAmount', 'evidenceUrl', 'status',
               'resolutionNote', 'resolvedBy', 'createdAt', 'updatedAt'
             ]) &&
             isValidId(data.id) &&
             isValidId(data.groupId) &&
             isValidId(data.memberId) &&
             (!('memberUid' in data) || isValidId(data.memberUid)) &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 150 &&
             data.description is string && data.description.size() > 0 && data.description.size() <= 1000 &&
             data.status in ['open', 'under_review', 'resolved', 'rejected'] &&
             data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() <= 64 &&
             data.updatedAt is string && data.updatedAt.size() > 0 && data.updatedAt.size() <= 64;
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['id', 'userId', 'title', 'message', 'category', 'read', 'createdAt']) &&
             data.keys().hasOnly([
               'id', 'userId', 'senderId', 'groupId', 'title', 'message',
               'category', 'read', 'createdAt', 'linkAction', 'linkTab'
             ]) &&
             isValidId(data.id) &&
             isValidId(data.userId) &&
             (!('senderId' in data) || isValidId(data.senderId)) &&
             (!('groupId' in data) || isValidId(data.groupId)) &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 150 &&
             data.message is string && data.message.size() > 0 && data.message.size() <= 500 &&
             data.category in ['payment', 'commitment', 'deadline', 'expense', 'dispute', 'announcement'] &&
             data.read is bool &&
             data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() <= 64;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['id', 'actorId', 'actorName', 'action', 'details', 'timestamp']) &&
             data.keys().hasOnly([
               'id', 'groupId', 'actorId', 'actorName', 'action', 'targetEntity',
               'targetId', 'reason', 'beforeValue', 'afterValue', 'details',
               'timestamp', 'ipAddress', 'securityEvent'
             ]) &&
             isValidId(data.id) &&
             isValidId(data.actorId) &&
             data.actorName is string && data.actorName.size() > 0 && data.actorName.size() <= 100 &&
             data.action is string && data.action.size() > 0 && data.action.size() <= 100 &&
             data.details is string && data.details.size() > 0 && data.details.size() <= 1000 &&
             data.timestamp is string && data.timestamp.size() > 0 && data.timestamp.size() <= 64;
    }

    function isValidCommunication(data) {
      return data.keys().hasAll(['id', 'groupId', 'subject', 'type', 'targetAudience', 'recipientCount', 'sentAt', 'sentBy']) &&
             data.keys().hasOnly([
               'id', 'groupId', 'subject', 'message', 'type', 'targetAudience',
               'contributionId', 'recipientCount', 'recipients', 'sentAt', 'sentBy', 'deliveredCount'
             ]) &&
             isValidId(data.id) &&
             isValidId(data.groupId) &&
             isValidId(data.sentBy) &&
             data.subject is string && data.subject.size() > 0 && data.subject.size() <= 200 &&
             (!('message' in data) || (data.message is string && data.message.size() <= 2000)) &&
             data.type in ['announcement', 'financial_reminder', 'payment_confirmation', 'deadline_alert', 'cleared_balance'] &&
             data.targetAudience in ['all_active', 'outstanding_only', 'overdue_only', 'paid_only', 'individual'] &&
             data.recipientCount is number && data.recipientCount >= 0 &&
             (!('recipients' in data) || (data.recipients is list && data.recipients.size() <= 200)) &&
             data.sentAt is string && data.sentAt.size() > 0 && data.sentAt.size() <= 64;
    }

    // Legacy admins collection locked down (no global cross-tenant admin bypass)
    match /admins/{adminId} {
      allow read, write: if false;
    }

    // Non-PII invite code lookup (signed-in users may look up a group invite by exact code)
    match /groupInvites/{inviteCode} {
      allow get: if isValidId(inviteCode) && isSignedIn();
      allow list: if isSignedIn() && resource.data.adminId == request.auth.uid;
      allow create: if isValidId(inviteCode) && isVerifiedAccount() &&
                    isValidGroupInvite(incoming()) &&
                    incoming().inviteCode == inviteCode &&
                    incoming().adminId == request.auth.uid &&
                    existsAfter(/databases/$(database)/documents/groups/$(incoming().groupId)) &&
                    getAfter(/databases/$(database)/documents/groups/$(incoming().groupId)).data.adminId == request.auth.uid;
      allow update: if isValidId(inviteCode) && isVerifiedAccount() &&
                    isValidGroupInvite(incoming()) &&
                    incoming().inviteCode == existing().inviteCode &&
                    incoming().groupId == existing().groupId &&
                    incoming().createdAt == existing().createdAt &&
                    existing().adminId == request.auth.uid &&
                    incoming().adminId == existing().adminId;
      allow delete: if isValidId(inviteCode) && isVerifiedAccount() &&
                    existing().adminId == request.auth.uid;
    }

    // Authenticated user profiles (strict single-owner isolation — no cross-account list/read)
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId) && isVerifiedAccount() &&
                    isOwner(userId) &&
                    isValidUser(incoming()) &&
                    incoming().id == userId &&
                    incoming().role in ['group_admin', 'treasurer', 'member'];
      allow update: if isValidId(userId) && isVerifiedAccount() &&
                    isOwner(userId) &&
                    isValidUser(incoming()) &&
                    incoming().id == existing().id &&
                    incoming().role == existing().role &&
                    incoming().createdAt == existing().createdAt &&
                    incoming().diff(existing()).affectedKeys().hasOnly([
                      'name', 'email', 'phone', 'roomNumber', 'avatarUrl', 'preferredLanguage'
                    ]);
      allow delete: if false;

      match /notifications/{notificationId} {
        allow get: if isValidId(userId) && isValidId(notificationId) && isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isValidId(userId) && isValidId(notificationId) &&
                      isVerifiedAccount() &&
                      isValidNotification(incoming()) &&
                      incoming().id == notificationId &&
                      incoming().userId == userId &&
                      incoming().senderId == request.auth.uid && (
                        isOwner(userId) ||
                        (
                          'groupId' in incoming() &&
                          (
                            isGroupManager(incoming().groupId) ||
                            (
                              isActiveGroupMember(incoming().groupId) &&
                              (
                                userId == groupDoc(incoming().groupId).adminId ||
                                ('treasurerId' in groupDoc(incoming().groupId) && userId == groupDoc(incoming().groupId).treasurerId)
                              )
                            )
                          )
                        )
                      );
        allow update: if isValidId(userId) && isValidId(notificationId) &&
                      isOwner(userId) &&
                      isValidNotification(incoming()) &&
                      incoming().id == existing().id &&
                      incoming().userId == existing().userId &&
                      incoming().createdAt == existing().createdAt &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['read']);
        allow delete: if isValidId(userId) && isValidId(notificationId) && isOwner(userId);
      }
    }

    // Shared financial groups & strictly scoped subcollections
    match /groups/{groupId} {
      allow get: if isValidId(groupId) && isActiveGroupMember(groupId);
      allow list: if isSignedIn() && (
        resource.data.adminId == request.auth.uid ||
        ('treasurerId' in resource.data && resource.data.treasurerId == request.auth.uid) ||
        ('memberUids' in resource.data && request.auth.uid in resource.data.memberUids)
      );
      allow create: if isValidId(groupId) && isVerifiedAccount() &&
                    isValidGroup(incoming()) &&
                    incoming().id == groupId &&
                    incoming().adminId == request.auth.uid &&
                    (!('memberUids' in incoming()) || request.auth.uid in incoming().memberUids);
      allow update: if isValidId(groupId) && isVerifiedAccount() &&
                    isValidGroup(incoming()) &&
                    (!('id' in existing()) || incoming().id == existing().id) &&
                    (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt) && (
                      // Tier 1: Group Admin (full non-immutable updates + ownership transfer)
                      existing().adminId == request.auth.uid ||
                      // Tier 2: Group Manager / Treasurer (cannot alter adminId or treasurerId)
                      (
                        isGroupManager(groupId) &&
                        incoming().adminId == existing().adminId
                      ) ||
                      // Tier 3: Atomic self-join via verified active, non-expired group code_auto invite
                      (
                        (!('joinPolicy' in existing()) || existing().joinPolicy == 'code_auto') &&
                        (!('inviteRevoked' in existing()) || existing().inviteRevoked != true) &&
                        (!('inviteExpiresAtMs' in existing()) || request.time.toMillis() < existing().inviteExpiresAtMs) &&
                        (!('status' in existing()) || existing().status == 'active') &&
                        incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'memberCount', 'updatedAt']) &&
                        ('memberUids' in incoming()) &&
                        request.auth.uid in incoming().memberUids &&
                        (
                          !('memberUids' in existing())
                            ? incoming().memberUids == [request.auth.uid]
                            : (
                                !(request.auth.uid in existing().memberUids) &&
                                incoming().memberUids.hasAll(existing().memberUids) &&
                                incoming().memberUids.size() == existing().memberUids.size() + 1
                              )
                        ) &&
                        (!('memberCount' in existing()) || incoming().memberCount == existing().memberCount + 1) &&
                        existsAfter(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)) &&
                        getAfter(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.userId == request.auth.uid &&
                        getAfter(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.roleInGroup == 'member' &&
                        getAfter(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.inviteCodeUsed == existing().joinCode
                      ) ||
                      // Tier 4: Voluntary self-leave by non-admin active member (preserves group & ledger records)
                      (
                        existing().adminId != request.auth.uid &&
                        incoming().adminId == existing().adminId &&
                        ('memberUids' in existing()) &&
                        request.auth.uid in existing().memberUids &&
                        incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'memberCount', 'treasurerId', 'updatedAt']) &&
                        ('memberUids' in incoming()) &&
                        !(request.auth.uid in incoming().memberUids) &&
                        incoming().memberUids.size() == existing().memberUids.size() - 1 &&
                        existing().memberUids.hasAll(incoming().memberUids) &&
                        (!('memberCount' in existing()) || incoming().memberCount == existing().memberCount - 1 || incoming().memberCount == 0) &&
                        (!('treasurerId' in incoming()) || incoming().treasurerId != request.auth.uid)
                      )
                    );
      allow delete: if isValidId(groupId) && isVerifiedAccount() && existing().adminId == request.auth.uid;

      match /joinRequests/{requestId} {
        allow get: if isValidId(groupId) && isValidId(requestId) && (
          isGroupManager(groupId) || (isSignedIn() && requestId == request.auth.uid)
        );
        allow list: if isSignedIn() && (
          resource.data.userId == request.auth.uid || isGroupManager(groupId)
        );
        allow create: if isValidId(groupId) && isValidId(requestId) && isVerifiedAccount() &&
                      isValidJoinRequest(incoming()) &&
                      requestId == request.auth.uid &&
                      incoming().id == request.auth.uid &&
                      incoming().userId == request.auth.uid &&
                      incoming().groupId == groupId &&
                      incoming().status == 'pending' &&
                      exists(/databases/$(database)/documents/groupInvites/$(incoming().inviteCode)) &&
                      get(/databases/$(database)/documents/groupInvites/$(incoming().inviteCode)).data.groupId == groupId &&
                      get(/databases/$(database)/documents/groupInvites/$(incoming().inviteCode)).data.revoked == false &&
                      (
                        !('expiresAtMs' in get(/databases/$(database)/documents/groupInvites/$(incoming().inviteCode)).data) ||
                        request.time.toMillis() < get(/databases/$(database)/documents/groupInvites/$(incoming().inviteCode)).data.expiresAtMs
                      );
        allow update: if isValidId(groupId) && isValidId(requestId) && isGroupManager(groupId) &&
                      isValidJoinRequest(incoming()) &&
                      incoming().id == existing().id &&
                      incoming().groupId == existing().groupId &&
                      incoming().userId == existing().userId &&
                      incoming().createdAt == existing().createdAt;
        allow delete: if isValidId(groupId) && isValidId(requestId) && (
          isGroupManager(groupId) || (isVerifiedAccount() && requestId == request.auth.uid)
        );
      }

      match /members/{memberId} {
        allow get: if isValidId(groupId) && isValidId(memberId) && isActiveGroupMember(groupId);
        allow list: if isActiveGroupMember(groupId);
        allow create: if isValidId(groupId) && isValidId(memberId) && isVerifiedAccount() &&
                      isValidGroupMember(incoming()) &&
                      incoming().id == memberId &&
                      incoming().groupId == groupId && (
                        isGroupManager(groupId) ||
                        (
                          existsAfter(/databases/$(database)/documents/groups/$(groupId)) &&
                          getAfter(/databases/$(database)/documents/groups/$(groupId)).data.adminId == request.auth.uid
                        ) ||
                        (
                          memberId == request.auth.uid &&
                          incoming().userId == request.auth.uid &&
                          incoming().roleInGroup == 'member' &&
                          incoming().status == 'active' &&
                          ('inviteCodeUsed' in incoming()) &&
                          groupExists(groupId) &&
                          (!('joinPolicy' in groupDoc(groupId)) || groupDoc(groupId).joinPolicy == 'code_auto') &&
                          (!('inviteRevoked' in groupDoc(groupId)) || groupDoc(groupId).inviteRevoked != true) &&
                          (!('inviteExpiresAtMs' in groupDoc(groupId)) || request.time.toMillis() < groupDoc(groupId).inviteExpiresAtMs) &&
                          (!('status' in groupDoc(groupId)) || groupDoc(groupId).status == 'active') &&
                          incoming().inviteCodeUsed == groupDoc(groupId).joinCode &&
                          request.auth.uid in getAfter(/databases/$(database)/documents/groups/$(groupId)).data.memberUids
                        )
                      );
        allow update: if isValidId(groupId) && isValidId(memberId) && isVerifiedAccount() &&
                      isValidGroupMember(incoming()) &&
                      (!('id' in existing()) || incoming().id == existing().id) &&
                      (!('groupId' in existing()) || incoming().groupId == existing().groupId) && (
                        isGroupAdmin(groupId) ||
                        (
                          isGroupManager(groupId) &&
                          existing().roleInGroup != 'admin' &&
                          incoming().roleInGroup in ['treasurer', 'member']
                        ) ||
                        (
                          isActiveGroupMember(groupId) &&
                          (
                            memberId == request.auth.uid ||
                            existing().userId == request.auth.uid ||
                            ('linkedUserId' in existing() && existing().linkedUserId == request.auth.uid)
                          ) &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'departedAt', 'departureReason', 'updatedAt']) &&
                          incoming().status == 'departed' &&
                          !(request.auth.uid in getAfter(/databases/$(database)/documents/groups/$(groupId)).data.memberUids) &&
                          getAfter(/databases/$(database)/documents/groups/$(groupId)).data.adminId != request.auth.uid
                        )
                      );
        allow delete: if false; // Preserve member directory & ledger integrity via soft status
      }

      match /contributions/{contributionId} {
        allow get: if isValidId(groupId) && isValidId(contributionId) && isActiveGroupMember(groupId);
        allow list: if isActiveGroupMember(groupId);
        allow create: if isValidId(groupId) && isValidId(contributionId) && isGroupManager(groupId) &&
                      isValidContribution(incoming()) &&
                      incoming().id == contributionId &&
                      incoming().groupId == groupId;
        allow update: if isValidId(groupId) && isValidId(contributionId) && isGroupManager(groupId) &&
                      isValidContribution(incoming()) &&
                      (!('id' in existing()) || incoming().id == existing().id) &&
                      (!('groupId' in existing()) || incoming().groupId == existing().groupId) &&
                      (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt);
        allow delete: if isValidId(groupId) && isValidId(contributionId) && isGroupAdmin(groupId);
      }

      match /assignments/{assignmentId} {
        allow get: if isValidId(groupId) && isValidId(assignmentId) && (
          isGroupManager(groupId) ||
          (
            isActiveGroupMember(groupId) && (
              existing().memberId == request.auth.uid ||
              ('memberUid' in existing() && existing().memberUid == request.auth.uid)
            )
          )
        );
        allow list: if isGroupManager(groupId) || (
          isActiveGroupMember(groupId) && (
            resource.data.memberId == request.auth.uid ||
            ('memberUid' in resource.data && resource.data.memberUid == request.auth.uid)
          )
        );
        allow create: if isValidId(groupId) && isValidId(assignmentId) && isGroupManager(groupId) &&
                      isValidAssignment(incoming()) &&
                      incoming().id == assignmentId &&
                      incoming().groupId == groupId;
        allow update: if isValidId(groupId) && isValidId(assignmentId) && isVerifiedAccount() &&
                      isValidAssignment(incoming()) &&
                      (!('id' in existing()) || incoming().id == existing().id) &&
                      (!('groupId' in existing()) || incoming().groupId == existing().groupId) && (
                        isGroupManager(groupId) ||
                        (
                          isActiveGroupMember(groupId) &&
                          (existing().memberId == request.auth.uid || ('memberUid' in existing() && existing().memberUid == request.auth.uid)) &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['status']) &&
                          incoming().status == 'pending_verification'
                        )
                      );
        allow delete: if isValidId(groupId) && isValidId(assignmentId) && isGroupAdmin(groupId);
      }

      match /payments/{paymentId} {
        allow get: if isValidId(groupId) && isValidId(paymentId) && (
          isGroupManager(groupId) ||
          (
            isActiveGroupMember(groupId) && (
              existing().memberId == request.auth.uid ||
              ('memberUid' in existing() && existing().memberUid == request.auth.uid) ||
              existing().collectorId == request.auth.uid
            )
          )
        );
        allow list: if isGroupManager(groupId) || (
          isActiveGroupMember(groupId) && (
            resource.data.memberId == request.auth.uid ||
            ('memberUid' in resource.data && resource.data.memberUid == request.auth.uid) ||
            resource.data.collectorId == request.auth.uid
          )
        );
        allow create: if isValidId(groupId) && isValidId(paymentId) && isVerifiedAccount() &&
                      isValidPayment(incoming()) &&
                      incoming().id == paymentId &&
                      incoming().groupId == groupId &&
                      incoming().collectorId == request.auth.uid && (
                        isGroupManager(groupId) ||
                        (
                          isActiveGroupMember(groupId) &&
                          (incoming().memberId == request.auth.uid || ('memberUid' in incoming() && incoming().memberUid == request.auth.uid)) &&
                          incoming().verificationStatus == 'pending_verification' &&
                          !('verifiedAt' in incoming()) &&
                          !('verifiedBy' in incoming()) &&
                          !('reversedAt' in incoming()) &&
                          !('reversedBy' in incoming())
                        )
                      );
        allow update: if isValidId(groupId) && isValidId(paymentId) && isGroupManager(groupId) &&
                      isValidPayment(incoming()) &&
                      (!('id' in existing()) || incoming().id == existing().id) &&
                      (!('groupId' in existing()) || incoming().groupId == existing().groupId) &&
                      incoming().amountReceived == existing().amountReceived &&
                      incoming().memberId == existing().memberId &&
                      incoming().assignmentId == existing().assignmentId &&
                      incoming().paymentMethod == existing().paymentMethod &&
                      incoming().transactionReference == existing().transactionReference &&
                      (!('collectorId' in existing()) || incoming().collectorId == existing().collectorId) &&
                      (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt) &&
                      existing().verificationStatus != 'reversed' &&
                      incoming().diff(existing()).affectedKeys().hasOnly([
                        'verificationStatus', 'verifiedAt', 'verifiedBy', 'rejectionReason',
                        'reversedAt', 'reversedBy', 'reversalReason',
                        'disputedAt', 'disputedBy', 'disputeReason'
                      ]);
        allow delete: if false; // Financial ledger records are immutable; reverse via status instead
      }

      match /commitments/{commitmentId} {
        allow get: if isValidId(groupId) && isValidId(commitmentId) && (
          isGroupManager(groupId) ||
          (
            isActiveGroupMember(groupId) && (
              existing().memberId == request.auth.uid ||
              ('memberUid' in existing() && existing().memberUid == request.auth.uid)
            )
          )
        );
        allow list: if isGroupManager(groupId) || (
          isActiveGroupMember(groupId) && (
            resource.data.memberId == request.auth.uid ||
            ('memberUid' in resource.data && resource.data.memberUid == request.auth.uid)
          )
        );
        allow create: if isValidId(groupId) && isValidId(commitmentId) && isGroupManager(groupId) &&
                      isValidCommitment(incoming()) &&
                      incoming().id == commitmentId &&
                      incoming().groupId == groupId;
        allow update: if isValidId(groupId) && isValidId(commitmentId) && isVerifiedAccount() &&
                      isValidCommitment(incoming()) &&
                      (!('id' in existing()) || incoming().id == existing().id) &&
                      (!('groupId' in existing()) || incoming().groupId == existing().groupId) && (
                        isGroupManager(groupId) ||
                        (
                          isActiveGroupMember(groupId) &&
                          (existing().memberId == request.auth.uid || ('memberUid' in existing() && existing().memberUid == request.auth.uid)) &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['status']) &&
                          incoming().status == 'extension_requested'
                        )
                      );
        allow delete: if isValidId(groupId) && isValidId(commitmentId) && isGroupAdmin(groupId);
      }

      match /commitmentEvents/{eventId} {
        allow get: if isValidId(groupId) && isValidId(eventId) && (
          isGroupManager(groupId) ||
          (isActiveGroupMember(groupId) && ('memberUid' in existing()) && existing().memberUid == request.auth.uid)
        );
        allow list: if isGroupManager(groupId) || (
          isActiveGroupMember(groupId) && ('memberUid' in resource.data) && resource.data.memberUid == request.auth.uid
        );
        allow create: if isValidId(groupId) && isValidId(eventId) && isVerifiedAccount() &&
                      isValidCommitmentEvent(incoming()) &&
                      incoming().id == eventId &&
                      incoming().recordedBy == request.auth.uid && (
                        isGroupManager(groupId) ||
                        (
                          isActiveGroupMember(groupId) &&
                          incoming().eventType == 'extension_requested' &&
                          ('memberUid' in incoming()) &&
                          incoming().memberUid == request.auth.uid
                        )
                      );
        allow update, delete: if false; // Immutable commitment audit log
      }

      match /expenses/{expenseId} {
        allow get: if isValidId(groupId) && isValidId(expenseId) && isActiveGroupMember(groupId);
        allow list: if isActiveGroupMember(groupId);
        allow create: if isValidId(groupId) && isValidId(expenseId) && isGroupManager(groupId) &&
                      isValidExpense(incoming()) &&
                      incoming().id == expenseId &&
                      incoming().groupId == groupId;
        allow update: if isValidId(groupId) && isValidId(expenseId) && isGroupManager(groupId) &&
                      isValidExpense(incoming()) &&
                      (!('id' in existing()) || incoming().id == existing().id) &&
                      (!('groupId' in existing()) || incoming().groupId == existing().groupId) &&
                      (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt);
        allow delete: if isValidId(groupId) && isValidId(expenseId) && isGroupAdmin(groupId);
      }

      match /disputes/{disputeId} {
        allow get: if isValidId(groupId) && isValidId(disputeId) && (
          isGroupManager(groupId) ||
          (
            isActiveGroupMember(groupId) && (
              existing().memberId == request.auth.uid ||
              ('memberUid' in existing() && existing().memberUid == request.auth.uid)
            )
          )
        );
        allow list: if isGroupManager(groupId) || (
          isActiveGroupMember(groupId) && (
            resource.data.memberId == request.auth.uid ||
            ('memberUid' in resource.data && resource.data.memberUid == request.auth.uid)
          )
        );
        allow create: if isValidId(groupId) && isValidId(disputeId) && isVerifiedAccount() &&
                      isActiveGroupMember(groupId) &&
                      isValidDispute(incoming()) &&
                      incoming().id == disputeId &&
                      incoming().groupId == groupId && (
                        isGroupManager(groupId) ||
                        (
                          (incoming().memberId == request.auth.uid || ('memberUid' in incoming() && incoming().memberUid == request.auth.uid)) &&
                          incoming().status == 'open'
                        )
                      );
        allow update: if isValidId(groupId) && isValidId(disputeId) && isGroupManager(groupId) &&
                      isValidDispute(incoming()) &&
                      (!('id' in existing()) || incoming().id == existing().id) &&
                      (!('groupId' in existing()) || incoming().groupId == existing().groupId) &&
                      (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt);
        allow delete: if false; // Immutable dispute history
      }

      match /auditLogs/{logId} {
        allow get: if isValidId(groupId) && isValidId(logId) && isGroupManager(groupId);
        allow list: if isGroupManager(groupId);
        allow create: if isValidId(groupId) && isValidId(logId) && isVerifiedAccount() &&
                      isValidAuditLog(incoming()) &&
                      incoming().id == logId &&
                      incoming().actorId == request.auth.uid && (
                        isGroupManager(groupId) ||
                        isActiveGroupMember(groupId) ||
                        (
                          existsAfter(/databases/$(database)/documents/groups/$(groupId)) &&
                          getAfter(/databases/$(database)/documents/groups/$(groupId)).data.adminId == request.auth.uid
                        )
                      );
        allow update, delete: if false; // Immutable audit trail
      }

      match /communications/{commId} {
        allow get: if isValidId(groupId) && isValidId(commId) && isGroupManager(groupId);
        allow list: if isGroupManager(groupId);
        allow create: if isValidId(groupId) && isValidId(commId) && isGroupManager(groupId) &&
                      isValidCommunication(incoming()) &&
                      incoming().id == commId &&
                      incoming().groupId == groupId &&
                      incoming().sentBy == request.auth.uid;
        allow update, delete: if false; // Immutable communication dispatch records
      }
    }
  }
}
